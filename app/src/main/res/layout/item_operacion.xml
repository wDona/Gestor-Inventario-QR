<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Indicador de estado (barra lateral fina) -->
        <View
            android:id="@+id/estadoIndicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/status_pendiente" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Fila 1: Tipo + Estado chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTipoOperacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Operación"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/AppStatusChip"
                    android:text="PENDIENTE"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Fila 2: Detalles compactos en una línea -->
            <TextView
                android:id="@+id/tvDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Producto #1 · Est. #2 · 10 uds"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Fila 3: Timestamp + Reintentar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="hace 5 min"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentar"
            style="@style/AppButtonText"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="↻ Reintentar"
            android:textSize="14sp"
            android:visibility="gone"
            android:minWidth="120dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
